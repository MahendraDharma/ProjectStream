# --- TMDB (gratis: https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_REGION=ID

# --- Perpustakaan lokal (folder video di host, dipisah ':') ---
PM_LIBRARY_DIRS=/media/movies:/media/tv

# --- Database & cache ---
PM_DB_PATH=/data/projectstream.db
PM_CACHE_DIR=/cache

# --- Opsional: cookies.txt untuk YouTube (pola ProjectMusic) ---
PM_COOKIES=

# --- Gerbang Caddy: secret link /masuk?k=<PS_KEY> ---
PS_KEY=ganti-dengan-rahasia-panjang
